# --- 서비스 ---
# 실제 주소 (로그인 리다이렉트, 결제 후 돌아올 주소). 배포 때는 https://...
APP_URL=http://127.0.0.1:47830
# 1이면 실패 원인을 콘솔에 자세히 보여 주고 개발용 로그인·테스트 결제 버튼을 연다. 배포 때는 0
IDLY_DEBUG=1
# SQLite 파일 위치 (기본은 메모리 DB, 예: data/idly.db)
# IDLY_DB=
# Supabase PostgreSQL URL (Vercel에는 필수, 자동으로 idly_report 스키마 사용)
# DATABASE_URL=

# --- 가격·보관 ---
REPORT_PRICE=4900
UNPAID_REPORT_DAYS=7
PAID_REPORT_DAYS=365

# --- 로그인 ---
# mock: 카카오·Apple 버튼을 누르면 테스트 계정으로 로그인 (지금 단계) / oauth: 실제 연동 (카카오·Apple만 구현됨)
AUTH_MODE=mock
# 아래는 oauth일 때 (mongle 웹과 같은 방식)
# 카카오 개발자 콘솔 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 > Redirect URI에 아래 주소들을 등록한다.
# 로컬 개발은 localhost 주소를 사용하고, Railway의 KAKAO_REDIRECT_URI에는 실제 서비스 주소를 설정한다.
# Railway 도메인으로 직접 서비스할 때만 https://idly.up.railway.app/auth/kakao/callback 사용
# 커스텀 도메인 서비스: https://idly.kr/auth/kakao/callback
KAKAO_REDIRECT_URI=http://127.0.0.1:47830/auth/kakao/callback
# 카카오 로그인 > 보안 > Client Secret을 켰을 때만
KAKAO_CLIENT_SECRET=
# Apple Developer > Identifiers > Services ID. Domain에 idly.up.railway.app, idly.kr을 등록하고,
# Return URL에 사용할 주소를 등록한다. 현재 Railway 설정:
APPLE_SERVICES_ID=
APPLE_WEB_REDIRECT_URI=https://idly.up.railway.app/auth/apple/callback

# --- 결제 (Paddle Billing) ---
# paddle | mock(개발용: 버튼을 누르면 바로 결제된 것으로 봄)
PAYMENT_MODE=paddle
# sandbox | production. 클라이언트 토큰·가격 id·웹훅 비밀값은 모두 같은 환경 것이어야 한다
PADDLE_ENV=production
# Developer tools > Authentication > Client-side tokens (live_… / test_…). 화면에 노출되는 공개 값
PADDLE_CLIENT_TOKEN=
# Catalog > Products > 리포트 상품의 가격 id (REPORT_PRICE와 같은 금액·KRW)
PADDLE_PRICE_ID=pri_01m4dyk9wy74xztmt78byqmkmt
# Developer tools > Notifications에서 {APP_URL}/api/webhooks/paddle 등록
# (transaction.completed, adjustment.created, adjustment.updated) 후 Secret key
PADDLE_WEBHOOK_SECRET=

# --- 운영 정보 (약관·푸터) ---
OPERATOR_NAME=IDly 팀
CONTACT_EMAIL=idly1apt@gmail.com
# 개인정보 보호책임자 이름 (개인정보처리방침에 필수)
PRIVACY_OFFICER=
TERMS_EFFECTIVE_DATE=2026년 10월 2일

# --- 분석 ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
