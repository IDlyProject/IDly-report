# --- 서비스 ---
# 실제 주소 (로그인 리다이렉트, 결제 후 돌아올 주소). 배포 때는 https://...
APP_URL=http://127.0.0.1:47830
# 1이면 실패 원인을 콘솔에 자세히 보여 주고 개발용 로그인·테스트 결제 버튼을 연다. 배포 때는 0
IDLY_DEBUG=1
# SQLite 파일 위치 (기본 backend/data/idly.db)
# IDLY_DB=

# --- 가격·보관 ---
REPORT_PRICE=4900
UNPAID_REPORT_DAYS=7
PAID_REPORT_DAYS=365

# --- 로그인 ---
# mock: 카카오·네이버·Google·Apple 버튼을 누르면 테스트 계정으로 로그인 (지금 단계) / oauth: 실제 연동 (카카오·Apple만 구현됨)
AUTH_MODE=mock
# 아래는 oauth일 때 (mongle 웹과 같은 방식)
# 카카오 개발자 콘솔 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 > Redirect URI에 등록한 주소와 정확히 같아야 한다
KAKAO_REDIRECT_URI=http://127.0.0.1:47830/auth/kakao/callback
# 카카오 로그인 > 보안 > Client Secret을 켰을 때만
KAKAO_CLIENT_SECRET=
# Apple Developer > Identifiers > Services ID (Sign in with Apple JS 팝업). 도메인·리턴 URL 등록 필요, https에서만 동작
APPLE_SERVICES_ID=
APPLE_WEB_REDIRECT_URI=

# --- 결제 (Lemon Squeezy) ---
# lemonsqueezy | mock(개발용: 버튼을 누르면 바로 결제된 것으로 봄)
PAYMENT_MODE=lemonsqueezy
LEMONSQUEEZY_CHECKOUT_URL=https://idly.lemonsqueezy.com/checkout/buy/5f3c2eed-bafc-44db-9f11-2ff201c1fbe7
# Settings > Webhooks에서 {APP_URL}/api/webhooks/lemonsqueezy 등록 (order_created, order_refunded) 후 서명 비밀값
LEMONSQUEEZY_WEBHOOK_SECRET=
# 있으면 Checkout API로 사용자별 결제창을 만든다 (없으면 위 고정 링크 + custom data)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=

# --- 운영 정보 (약관·푸터) ---
OPERATOR_NAME=IDly 팀
CONTACT_EMAIL=support@idly.kr
# 개인정보 보호책임자 이름 (개인정보처리방침에 필수)
PRIVACY_OFFICER=
TERMS_EFFECTIVE_DATE=2026년 10월 2일

# --- 분석 ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
